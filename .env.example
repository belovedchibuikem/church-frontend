# Design-review access bypass (read by lib/server-access.ts → getServerAccessContext).
# true  = full-access fixture (authenticated, MFA ok, permission *, broad scopes) — UI review only
# false = production: GET /user/me + /user/capabilities with session cookies; no session → unauthenticated
# Keep false in shared/staging/production. When false, design full-access is OFF.
FHC_ENABLE_DESIGN_FIXTURES=false
# Browser mirror so client components honor the same fixture gate (content fixtures only; not access bypass).
NEXT_PUBLIC_FHC_ENABLE_DESIGN_FIXTURES=false
NEXT_PUBLIC_SITE_URL=https://admin.example.org

# -----------------------------------------------------------------------------
# Laravel API URL (pick one style; the web client accepts both)
# Production: set real HTTPS origins — there is no localhost fallback in code.
# -----------------------------------------------------------------------------
# Style A — origin only (generated TS clients under api/clients/typescript + INTEGRATION.md).
# Paths are absolute: /api/v1/..., /api/v1/auth/csrf-cookie, etc.
# Locally the browser is rewritten to same-origin `/api` (Vite/Next proxy → Laravel) so
# session cookies survive refresh. Keep FHC_LARAVEL_API_URL on the real Laravel origin.
NEXT_PUBLIC_FHC_API_BASE_URL=http://localhost:8000

# Style B — explicit /api/v1 base (browser maps UI + this app’s apiRequest path joins).
# Server RSC/route handlers should set FHC_LARAVEL_API_URL the same way.
FHC_LARAVEL_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_FHC_API_URL=http://localhost:8000/api/v1

# -----------------------------------------------------------------------------
# Browser cookie session + CSRF (required for /api/v1/auth/* mutating calls)
# -----------------------------------------------------------------------------
# 1) GET {API}/auth/csrf-cookie with credentials → sets:
#      - family_house_connect_session (SESSION_COOKIE on Laravel)
#      - XSRF-TOKEN
# 2) Mutating requests send header X-XSRF-TOKEN = decoded XSRF-TOKEN cookie value
# 3) All browser auth/user fetches use credentials: 'include'
#
# Same-site / reverse-proxy: RSC member+admin gating forwards Cookie from the Next request
# to Laravel. Prefer same-site deploy (or BFF) so the session cookie is visible to Next.
# Password reset emails use Laravel BROWSER_PASSWORD_RESET_URL → this app’s /reset-password.
# Email verification links hit GET /api/v1/auth/email/verify/{id}/{hash} (signed); optional
# frontend landing: /verify-email?id=&hash=&expires=&signature=

# -----------------------------------------------------------------------------
# Production checklist (honest)
# -----------------------------------------------------------------------------
# - Keep both FHC_ENABLE_DESIGN_FIXTURES and NEXT_PUBLIC_FHC_ENABLE_DESIGN_FIXTURES=false
# - Point API URLs at HTTPS origins (Style A or B — not both conflicting hosts)
# - NEXT_PUBLIC_SITE_URL should be the public member site origin (not only admin)
# - Maps tiles/provider keys are configured via Laravel admin platform APIs, not this file
# - Giving: Laravel PAYMENT_GOVERNANCE_MODE=deny by default (422 until OD-009/010)
